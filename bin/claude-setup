#!/usr/bin/env bash
# claude-setup
# Interactive manager for Claude Code configuration.
# Run with no args for interactive mode, or pass a subcommand directly.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

BOLD="\033[1m"
DIM="\033[2m"
CYAN="\033[36m"
GREEN="\033[32m"
YELLOW="\033[33m"
RESET="\033[0m"

show_reference() {
  # Generated from the repo, never hardcoded — a hardcoded list is how this
  # screen ended up advertising eight commands that had been retired.
  echo ""
  echo -e "${BOLD}${CYAN}Slash Commands${RESET} ${DIM}(run inside a Claude Code session)${RESET}"
  echo ""
  list_entries "$REPO_DIR/global/skills" "user"
  echo ""
  echo -e "${BOLD}${CYAN}Skills${RESET} ${DIM}(Claude loads these automatically)${RESET}"
  echo ""
  list_entries "$REPO_DIR/global/skills" "model"
  echo ""
  echo -e "${BOLD}${CYAN}Agents${RESET} ${DIM}(delegated to, or @-mentioned directly)${RESET}"
  echo ""
  for f in "$REPO_DIR"/global/agents/*.md; do
    [[ -f "$f" ]] || continue
    printf "  ${GREEN}%-22s${RESET} %s\n" "$(basename "$f" .md)" "$(first_desc_line "$f")"
  done
  echo ""
}

# Pull the first line of the frontmatter `description:` (handles `>` block form).
first_desc_line() {
  awk '
    /^---[[:space:]]*$/ { n++; next }
    n == 1 && /^description:/ {
      sub(/^description:[[:space:]]*>?-?[[:space:]]*/, "")
      if (length($0)) { gsub(/^"|"$/, ""); print; exit }
      getline; sub(/^[[:space:]]+/, ""); gsub(/^"|"$/, ""); print; exit
    }
  ' "$1" | cut -c1-64
}

# Locate a skill body in either layout: <name>/SKILL.md or the legacy <name>.md
skill_files() {
  local dir="$1"
  ls -1 "$dir"/*/SKILL.md 2>/dev/null || true
  ls -1 "$dir"/*.md 2>/dev/null || true
}

# $2 = "user" for /-invocable entries (disable-model-invocation: true),
#      "model" for everything Claude picks up on its own.
list_entries() {
  local dir="$1" want="$2" f name hint manual
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    case "$f" in
      */SKILL.md) name="$(basename "$(dirname "$f")")" ;;
      *)          name="$(basename "$f" .md)" ;;
    esac
    if grep -qiE '^disable-model-invocation:[[:space:]]*(true|yes|on|1)' "$f"; then
      manual="user"
    else
      manual="model"
    fi
    [[ "$manual" == "$want" ]] || continue
    # `|| true` matters: under `set -e` a failing command substitution in an
    # assignment aborts the script, and most entries have no argument-hint.
    hint="$(grep -m1 '^argument-hint:' "$f" | sed 's/^argument-hint:[[:space:]]*//' || true)"
    if [[ "$want" == "user" ]]; then
      printf "  ${GREEN}%-26s${RESET} %s\n" "/$name $hint" "$(first_desc_line "$f")"
    else
      printf "  ${GREEN}%-26s${RESET} %s\n" "$name" "$(first_desc_line "$f")"
    fi
  done < <(skill_files "$dir" | sort -u)
}

show_status() {
  echo ""
  echo -e "${BOLD}${CYAN}Current Status${RESET}"
  echo ""

  # Global config. Count SKILL.md entrypoints, not every .md — skills now carry
  # references/ subfiles, and ~/.claude/commands/ has been empty since commands
  # became skills, so counting it always reported 0.
  if [[ -d "$HOME/.claude/skills" ]]; then
    skill_count=$(ls -d "$HOME"/.claude/skills/*/SKILL.md 2>/dev/null | wc -l | tr -d ' ')
    agent_count=$(ls -1 "$HOME"/.claude/agents/*.md 2>/dev/null | wc -l | tr -d ' ')
    user_rule_count=$(ls -1 "$HOME"/.claude/rules/*.md 2>/dev/null | wc -l | tr -d ' ')
    linked=$(find "$HOME/.claude/skills" -maxdepth 1 -type l 2>/dev/null | wc -l | tr -d ' ')
    dangling=$(find "$HOME/.claude/skills" "$HOME/.claude/agents" -maxdepth 1 -type l ! -exec test -e {} \; -print 2>/dev/null | wc -l | tr -d ' ')
    echo -e "  ${GREEN}Global config:${RESET}  $skill_count skills, $agent_count agents, $user_rule_count user rules"
    if [[ "$linked" -gt 0 ]]; then
      echo -e "  ${GREEN}Link mode:${RESET}      symlinked to repo ($linked live) — edits apply immediately"
    else
      echo -e "  ${YELLOW}Link mode:${RESET}      copies. Run: install-claude-setup --force  (converts to symlinks)"
    fi
    if [[ "$dangling" -gt 0 ]]; then
      echo -e "  ${YELLOW}Dangling:${RESET}       $dangling broken symlink(s). Run: install-claude-setup --force"
    fi
  else
    echo -e "  ${YELLOW}Global config:${RESET}  Not installed. Run: claude-setup install"
  fi

  # Current project
  if [[ -f ".claude/CLAUDE.md" ]]; then
    echo -e "  ${GREEN}Current project:${RESET} .claude/CLAUDE.md found"
    if [[ -f ".claude/rules/org.md" ]]; then
      org_name="$(grep -m1 '^# ' .claude/rules/org.md 2>/dev/null | sed 's/^# Org Conventions.*— //' || echo "configured")"
      echo -e "  ${GREEN}Org rules:${RESET}      $org_name"
    else
      echo -e "  ${YELLOW}Org rules:${RESET}      Not set. Run: /set-org"
    fi
    rule_count=$(find .claude/rules -name "*.md" 2>/dev/null | wc -l | tr -d ' ')
    echo -e "  ${GREEN}Path rules:${RESET}     $rule_count files"
  else
    echo -e "  ${YELLOW}Current project:${RESET} Not initialized. Run: claude-setup init"
  fi
  echo ""
}

interactive_menu() {
  echo ""
  echo -e "${BOLD}Claude Code Setup${RESET}"
  echo -e "${DIM}$REPO_DIR${RESET}"

  show_status

  echo -e "${BOLD}What do you want to do?${RESET}"
  echo ""
  echo -e "  ${GREEN}1${RESET}  Install global config            ${DIM}(skills, agents, commands → ~/.claude/)${RESET}"
  echo -e "  ${GREEN}2${RESET}  Init new project                 ${DIM}(first-time scaffold .claude/ + docs/)${RESET}"
  echo -e "  ${GREEN}3${RESET}  Update existing project          ${DIM}(pull latest templates, backs up first)${RESET}"
  echo -e "  ${GREEN}4${RESET}  Set org for current project      ${DIM}(copy org rules: arete, xomware, custom)${RESET}"
  echo -e "  ${GREEN}5${RESET}  Scan projects for promotions     ${DIM}(find unique project configs to promote)${RESET}"
  echo -e "  ${GREEN}6${RESET}  Show slash command reference      ${DIM}(all commands available in Claude sessions)${RESET}"
  echo -e "  ${GREEN}q${RESET}  Quit"
  echo ""
  read -rp "  > " choice

  case "$choice" in
    1)
      echo ""
      read -rp "  Force overwrite? (backs up first) [y/N] " force
      if [[ "$force" =~ ^[Yy]$ ]]; then
        exec "$REPO_DIR/bin/install-claude-setup" --force
      else
        exec "$REPO_DIR/bin/install-claude-setup"
      fi
      ;;
    2)
      echo ""
      if [[ -f ".claude/CLAUDE.md" ]]; then
        echo -e "  ${YELLOW}Project already initialized.${RESET} Use option 3 to update."
      else
        exec "$REPO_DIR/bin/init-claude-setup"
      fi
      ;;
    3)
      echo ""
      if [[ ! -f ".claude/CLAUDE.md" ]]; then
        echo -e "  ${YELLOW}Project not initialized yet.${RESET} Use option 2 first."
      else
        echo -e "  Updating project templates (backs up existing, never touches CLAUDE.md)..."
        echo ""
        exec "$REPO_DIR/bin/init-claude-setup" --force
      fi
      ;;
    4)
      echo ""
      echo -e "  ${BOLD}Available org configs:${RESET}"
      echo ""
      i=1
      orgs=()
      for f in "$REPO_DIR"/examples/org-*.md; do
        [[ -f "$f" ]] || continue
        name="$(basename "$f" .md | sed 's/^org-//')"
        desc="$(grep -m1 '^# ' "$f" | sed 's/^# Org Conventions.*— //')"
        echo -e "  ${GREEN}$i${RESET}  $name  — $desc"
        orgs+=("$name")
        ((i++))
      done
      echo -e "  ${GREEN}$i${RESET}  custom  — Start from blank skeleton"
      orgs+=("custom")
      echo ""
      read -rp "  Pick an org [1-$i]: " org_choice

      if [[ "$org_choice" -ge 1 && "$org_choice" -le "${#orgs[@]}" ]] 2>/dev/null; then
        selected="${orgs[$((org_choice-1))]}"
        target=".claude/rules/org.md"

        if [[ ! -d ".claude/rules" ]]; then
          echo ""
          echo "  No .claude/rules/ directory. Run 'claude-setup init' first."
          exit 1
        fi

        if [[ "$selected" == "custom" ]]; then
          cp "$REPO_DIR/project-template/.claude/rules/org.md" "$target"
          echo ""
          echo -e "  ${GREEN}Copied blank skeleton to $target${RESET}"
          echo "  Fill in: secrets, auth, cloud/infra, CI/CD, common mistakes"
        else
          src="$REPO_DIR/examples/org-$selected.md"
          if [[ -f "$src" ]]; then
            cp "$src" "$target"
            echo ""
            echo -e "  ${GREEN}Set org to: $selected${RESET}"
            echo "  Written to: $target"
          else
            echo "  Org file not found: $src"
            exit 1
          fi
        fi
      else
        echo "  Invalid choice."
        exit 1
      fi
      ;;
    5)
      echo ""
      exec "$REPO_DIR/bin/update-claude-setup" --report
      ;;
    6)
      show_reference
      ;;
    q|Q|"")
      exit 0
      ;;
    *)
      echo "  Invalid choice."
      exit 1
      ;;
  esac
}

# Direct subcommand mode
case "${1:-}" in
  install)
    shift
    exec "$REPO_DIR/bin/install-claude-setup" "$@"
    ;;
  init)
    shift
    exec "$REPO_DIR/bin/init-claude-setup" "$@"
    ;;
  update-project)
    shift
    exec "$REPO_DIR/bin/init-claude-setup" --force "$@"
    ;;
  scan)
    shift
    exec "$REPO_DIR/bin/update-claude-setup" "$@"
    ;;
  help|--help|-h)
    show_reference
    show_status
    ;;
  "")
    interactive_menu
    ;;
  *)
    echo "Unknown command: $1"
    echo "Run 'claude-setup' with no arguments for interactive mode."
    exit 1
    ;;
esac
